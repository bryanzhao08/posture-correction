# Directory to store SQLite database, JWT secrets, and outbox emails locally
FORMCOACH_DATA_DIR=/app/data

# SQLAlchemy database URL (defaults to sqlite:///{FORMCOACH_DATA_DIR}/formcoach.db)
FORMCOACH_DATABASE_URL=sqlite:////app/data/formcoach.db

# Secret key for signing JWT auth tokens
FORMCOACH_JWT_SECRET=super_secret_placeholder_change_me_in_production

# Resend API key for sending emails. Leave blank to write emails locally to the outbox.
RESEND_API_KEY=re_123456789_placeholder

# The "From" address for outbound emails
FORMCOACH_EMAIL_FROM="FormCoach <onboarding@resend.dev>"
