      "training": [
        {
          "id": "groundstrokes",
          "label": "Groundstrokes",
          "recommended": "back",
          "views": [
            "back",
            "side",
            "front"
          ],
          "why": "From behind, the camera sees your spacing from the ball, your turn and your finish."
        },
        {
          "id": "contact",
          "label": "Contact point & weight transfer",
          "recommended": "side",
          "views": [
            "side"
          ],
          "why": "Side-on is the only view that shows how far in front you hit and how your weight moves forward."
        },
        {
          "id": "serve",
          "label": "Serve",
          "recommended": "side",
          "views": [
            "side",
            "back"
          ],
          "why": "Side-on shows your reach, extension and how you drive up into the ball."
        },
        {
          "id": "volleys",
          "label": "Volleys & net play",
          "recommended": "front",
          "views": [
            "front",
            "side"
          ],
          "why": "Face-on, like a player across the net, shows your ready position and compact swing."
        }
      ],
